# Environment variables for image generation worker
# Copy to .env and fill in values

# Database (independent, worker-owned)
DATABASE_URL=postgresql://user:pass@host:5432/image_worker

# Redis (shared queue)
REDIS_URL=redis://localhost:6379

# Admin password for dashboard login
ADMIN_PASSWORD=

# Provider API key encryption key
PROVIDER_KEY_ENCRYPTION_KEY=

# App secret (for API key hashing)
APP_SECRET=

# Internal API secret used by proxy-to-route calls. Defaults to APP_SECRET if unset.
INTERNAL_API_SECRET=

# Object storage backend: cos | r2
STORAGE_BACKEND=cos

# Tencent Cloud COS
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_PUBLIC_BASE_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=

# Resend (registration email verification codes)
# 未配置时进入开发模式：验证码只打印到服务端日志，并在接口响应中返回 devCode（仅非生产环境）
RESEND_API_KEY=
# 发件人，例如 "Image Worker <noreply@your-domain.com>"；默认 onboarding@resend.dev（仅适合测试）
EMAIL_FROM=
